{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "android": { "buildType": "apk" },
      "env": { "APP_ENV": "development" }
    },
    "production": {
      "channel": "production",
      "distribution": "store",
      "autoIncrement": true,
      "android": { "buildType": "apk" },
      "env": { "APP_ENV": "production", "EXPO_PUBLIC_API_URL": "https://here-there.susmitha.site" }
    },
    "development-testflight": { "extends": "development", "distribution": "store", "autoIncrement": true },
    "production-testflight": { "extends": "production" }
  },
  "submit": {
    "development-testflight": { "ios": { "ascAppId": "REPLACE_WITH_DEV_APP_APPLE_ID" } },
    "production-testflight": { "ios": { "ascAppId": "REPLACE_WITH_MAIN_APP_APPLE_ID" } }
  }
}
