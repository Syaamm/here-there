DATABASE_URL="file:./dev.db"
JWT_SECRET=change-me            # required when NODE_ENV=production
PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:8081
# Email (verification codes). Set SMTP_URL to deliver real mail, e.g. smtps://user:pass@smtp.example.com
# Without it, codes are printed in this API's console.
SMTP_URL=
EMAIL_FROM="HERE & THERE <no-reply@herethere.local>"
# DEMO SERVER ONLY (made-up data, never real people): DEMO_MODE=true shows email and phone codes in the app and sends the ID check to our own
# simulated page, even with NODE_ENV=production. The API says so loudly at every start. Leave it off for a real launch.
# DEMO_MODE=true
# DEV ONLY: also return the code to the app so a phone can finish sign-up with no mail server.
# The API refuses to start in production with this on.
EMAIL_DEV_ECHO=true
# manual  = identity checks wait for staff approval in the admin console (no provider connected yet)
# sandbox = simulated provider: hosted page + signed webhook, the same path a real vendor uses (dev only)
# auto    = approves instantly (local demos only)
# Real vendors: persona and idenfy (settings below). Another one is added as a provider in verification.service.ts.
VERIFICATION_MODE=sandbox
# How long one successful verification lasts before a new check is needed (days).
VERIFICATION_VALID_DAYS=365
# Optional mobile-number codes by SMS (Twilio). Without these, codes print in the API console.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# How many proxies (Cloudflare, a load balancer) sit in front of the API. The rate limits go by visitor address, and behind a
# proxy every visitor otherwise looks like the proxy. Use a number (1), or loopback for a tunnel on this PC. Never "true".
# TRUST_PROXY=
# Shared links (https://<domain>/a/<id>, /t/<id>): where the page sends people who do not have the app. Fill these in
# once the app is listed. APPLE_TEAM_ID and ANDROID_CERT_SHA256 make phones open the app straight from the link.
# APP_STORE_URL=
# PLAY_STORE_URL=
# APPLE_TEAM_ID=
# ANDROID_CERT_SHA256=
# Identity verification: VERIFICATION_MODE=persona uses Persona's hosted flow (see docs/FOR_DEPLOYMENT.md, "Identity verification with Persona").
# The API key and the webhook secret are secrets: set them only on the machine that runs the API.
# PERSONA_API_KEY=
# PERSONA_WEBHOOK_SECRET=
# PERSONA_TEMPLATE_ID=            (government ID + selfie)
# PERSONA_TEMPLATE_ID_DOCUMENT=   (government ID only, no selfie: the route with nothing biometric)
# PERSONA_TEMPLATE_ENFORCES_18=   true only if the Persona template itself refuses people under 18 and collects no birth date
# PERSONA_REDACT=false            testing only: keeps the personal data at Persona after a decision (it is erased by default)
# VERIFICATION_MODE=idenfy uses iDenfy's hosted flow instead (EU data centres; see docs/FOR_DEPLOYMENT.md, "Identity verification with iDenfy").
# IDENFY_API_KEY=
# IDENFY_API_SECRET=
# IDENFY_WEBHOOK_SECRET=          the signing key set on the webhook (Settings > System notifications)
# IDENFY_REDIRECT_URI=            optional, https: where iDenfy sends the person's browser when they finish
# IDENFY_ENFORCES_18=             true only if the iDenfy account itself refuses under-18s and sends no birth date
# IDENFY_REDACT=false             testing only: keeps the personal data at iDenfy after a decision (it is deleted by default)
# Production only: the seed script then makes just the admin, and needs your own password (14+ characters).
# ADMIN_PASSWORD=
