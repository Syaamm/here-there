# Copy to .env (git-ignored). EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.

# Where the API lives. Leave empty in development: the app finds your computer automatically
# when you run it through Expo Go on the same Wi-Fi. Set it for builds that must talk to a server.
# Production must be HTTPS.
EXPO_PUBLIC_API_URL=

# Needed for map tiles in standalone Android/iOS builds (not in Expo Go).
GOOGLE_MAPS_ANDROID_KEY=
GOOGLE_MAPS_IOS_KEY=
