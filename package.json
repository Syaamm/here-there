{
  "name": "here-there",
  "private": true,
  "workspaces": ["services/*", "apps/*", "packages/*"],
  "scripts": {
    "api": "npm start -w @here-there/api",
    "admin": "npm run mobile",
    "admin:standalone": "npm run dev -w @here-there/admin",
    "admin:build": "npm run build -w @here-there/admin",
    "build:web": "node scripts/build-web.cjs",
    "build:all": "npm run db:generate -w @here-there/api && npm run build -w @here-there/api && node scripts/build-web.cjs",
    "deploy": "node scripts/deploy.cjs",
    "mobile": "npm start -w @here-there/mobile"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "body-parser": "^2.4.0",
    "multer": "^2.5.0"
  }
}
